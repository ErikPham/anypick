---
import { Icon } from "astro-icon/components";
import { config } from "virtual:nimbus/config";
import Header from "../components/Header.astro";
import RoutingConcept from "../components/RoutingConcept.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const releasesUrl = "https://github.com/outof0/anypick/releases/latest";
const npmCommand = "npm install -g anypick";

const capabilities = [
  {
    label: "Cross-provider routes",
    value: "Claude Code · Codex",
    detail: "Compatible accounts, proxies, and gateways",
  },
  {
    label: "Native account switching",
    value: "Gemini · Kiro",
    detail: "Switches the provider's own live credential",
  },
  {
    label: "Bring your own gateway",
    value: "OpenRouter · LiteLLM",
    detail: "Or another compatible endpoint",
  },
];

const workflow = [
  {
    number: "01",
    title: "See what powers each app",
    body: "Claude Code and Codex show their current source, model, usage when available, and whether the route needs attention.",
  },
  {
    number: "02",
    title: "Choose a compatible source",
    body: "Pick a native account, gateway, managed proxy, Proxy Hub, or saved setup. Incompatible pairings never appear.",
  },
  {
    number: "03",
    title: "Review every change",
    body: "AnyPick previews the binding, model roles, proxy start, and client configuration before it writes anything.",
  },
  {
    number: "04",
    title: "Activate, then keep coding",
    body: "The approved plan drives both execution and rollback, so the route shown in Apps stays the source of truth.",
  },
];

const appBenefits = [
  {
    icon: "ph:cursor-click",
    title: "Switch from the menu bar",
    body: "Change an app's source without reopening config files or leaving the tool you are using.",
  },
  {
    icon: "ph:gauge",
    title: "See usage where supported",
    body: "Keep the active identity, model, and provider quota in the same compact view.",
  },
  {
    icon: "ph:shield-check",
    title: "Keep secrets out of the UI",
    body: "The native UI sends typed actions to its bundled Go service; credentials and proxy bearer tokens stay behind that boundary.",
  },
];

const proof = [
  {
    icon: "ph:identification-card",
    title: "Reuse provider-owned logins",
    body: "AnyPick snapshots credentials created by the provider's own sign-in flow. It never impersonates that flow or asks for your password.",
    href: "/docs/guides/accounts",
    link: "Accounts guide",
  },
  {
    icon: "ph:folders",
    title: "Route one project differently",
    body: "Bindings resolve per launch, then per directory, then globally. Change one repository without disturbing the rest.",
    href: "/docs/guides/projects",
    link: "Project bindings",
  },
  {
    icon: "ph:arrows-left-right",
    title: "Supervise local translation",
    body: "When protocols differ, the bundled Go service owns the required loopback proxy instead of making the UI reimplement it.",
    href: "/docs/guides/proxies",
    link: "Proxy guide",
  },
];
---

<BaseLayout
  title={`${config.title} — ${config.description}`}
  description={config.description}
  socialImage="/og-image.png"
>
  <div class="landing min-h-screen bg-[#080A11] text-[#F8FAFC]">
    <Header showSidebar={false} appearance="landing" />

    <main id="main-content">
      <section class="hero relative isolate overflow-hidden">
        <div class="hero-grid pointer-events-none absolute inset-0 -z-20" aria-hidden="true"></div>
        <div class="hero-light pointer-events-none absolute -z-10" aria-hidden="true"></div>

        <div class="mx-auto grid w-full max-w-7xl items-center gap-14 px-5 pt-16 pb-20 sm:px-8 sm:pt-20 lg:grid-cols-[0.88fr_1.12fr] lg:gap-16 lg:pt-24 lg:pb-28">
          <div class="hero-copy max-w-2xl">
            <p class="eyebrow">
              <span></span>
              Native releases · one Go engine
            </p>

            <h1 class="mt-7 text-balance text-[clamp(3rem,7vw,5.4rem)] font-semibold leading-[0.96] tracking-[-0.055em]">
              Pick any.<br />
              <span>Code on.</span>
            </h1>

            <p class="mt-7 max-w-xl text-pretty text-lg leading-8 text-[#98A2B3] sm:text-xl">
              Route <strong>Claude Code</strong> and <strong>Codex</strong> through compatible accounts and gateways you already have. Switch native provider logins from the same place.
            </p>

            <div class="mt-9 flex flex-wrap items-center gap-3">
              <a class="primary-cta" href="/docs/getting-started">
                Get started
                <Icon name="ph:arrow-right" class="h-4 w-4" />
              </a>
              <a class="secondary-cta" href="#workflow">See the workflow</a>
            </div>

            <a class="download-link mt-8 max-w-lg" href={releasesUrl}>
              <Icon name="ph:download-simple" class="h-4 w-4" aria-hidden="true" />
              <span>Download on GitHub Releases</span>
              <Icon name="ph:arrow-up-right" class="ml-auto h-4 w-4" aria-hidden="true" />
            </a>
            <div class="install-shell mt-3 max-w-lg">
              <span class="prompt" aria-hidden="true">$</span>
              <code>{npmCommand}</code>
              <button type="button" data-copy={npmCommand} aria-label="Copy npm install command">
                <Icon name="ph:copy" class="copy-icon h-4 w-4" />
                <Icon name="ph:check" class="check-icon hidden h-4 w-4" />
                <span>Copy</span>
              </button>
            </div>
            <p class="mt-3 font-mono text-xs text-[#8b93a7]">macOS 14+ · Linux/Windows · npm launcher installs the native CLI</p>
            <p class="sr-only" aria-live="polite" data-copy-status></p>
          </div>

          <div class="hero-product relative mx-auto w-full max-w-[38rem] lg:mr-0">
            <RoutingConcept variant="hero" />
          </div>
        </div>
      </section>

      <section aria-label="Compatibility overview" class="border-y border-white/8 bg-white/[0.018]">
        <div class="mx-auto grid w-full max-w-7xl divide-y divide-white/8 px-5 sm:px-8 lg:grid-cols-3 lg:divide-x lg:divide-y-0">
          {capabilities.map((item) => (
            <div class="py-7 lg:px-8 lg:first:pl-0 lg:last:pr-0">
              <p class="font-mono text-[0.68rem] uppercase tracking-[0.16em] text-[#8b93a7]">{item.label}</p>
              <p class="mt-2 text-base font-semibold text-[#F8FAFC]">{item.value}</p>
              <p class="mt-1 text-sm text-[#98A2B3]">{item.detail}</p>
            </div>
          ))}
        </div>
      </section>

      <section id="workflow" class="section-shell">
        <div class="mx-auto w-full max-w-7xl px-5 sm:px-8">
          <div class="section-heading max-w-3xl">
            <p class="section-kicker">Apps route builder</p>
            <h2>Know what will change before it changes.</h2>
            <p>Apps turns routing into one deliberate flow instead of a collection of credential files, environment variables, and background processes.</p>
          </div>

          <div class="mt-14 grid gap-5 md:grid-cols-2">
            {workflow.map((step) => (
              <article class="workflow-card">
                <div class="flex items-start gap-5">
                  <span class="step-number">{step.number}</span>
                  <div>
                    <h3>{step.title}</h3>
                    <p>{step.body}</p>
                  </div>
                </div>
              </article>
            ))}
          </div>

          <div class="plan-panel mt-8 grid overflow-hidden lg:grid-cols-[0.78fr_1.22fr]">
            <div class="border-b border-white/8 p-7 sm:p-9 lg:border-r lg:border-b-0">
              <p class="section-kicker">Activation preview</p>
              <h3 class="mt-4 text-2xl font-semibold tracking-[-0.03em]">A plan you can inspect.</h3>
              <p class="mt-4 leading-7 text-[#98A2B3]">Nothing is written until you confirm. The same planned steps drive execution and rollback.</p>
              <a class="text-link mt-6" href="/docs/guides/terminal-ui">
                Explore the terminal UI
                <Icon name="ph:arrow-up-right" class="h-4 w-4" />
              </a>
            </div>
            <div class="plan-code p-5 sm:p-7">
              <div class="plan-titlebar">
                <span></span><span></span><span></span>
                <p>Claude Code → grok/work</p>
              </div>
              <ol>
                <li><span>01</span><div><strong>Bind app</strong><small>Claude Code uses grok/work</small></div><b>ready</b></li>
                <li><span>02</span><div><strong>Start owned proxy</strong><small>Loopback only · secret stays private</small></div><b>planned</b></li>
                <li><span>03</span><div><strong>Set model</strong><small>grok-code-fast-1</small></div><b>planned</b></li>
                <li><span>04</span><div><strong>Write client config</strong><small>After confirmation</small></div><b>planned</b></li>
              </ol>
            </div>
          </div>
        </div>
      </section>

      <section class="section-shell border-y border-white/8 bg-[#0B0D15]">
        <div class="mx-auto grid w-full max-w-7xl gap-12 px-5 sm:px-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:items-start lg:gap-24">
          <RoutingConcept variant="desktop" class="order-2 lg:order-1" />

          <div class="order-1 lg:order-2">
            <p class="section-kicker">Desktop control</p>
            <h2 class="mt-4 text-balance text-[clamp(2.25rem,5vw,3.8rem)] font-semibold leading-[1.04] tracking-[-0.045em]">The route switcher lives where you work.</h2>
            <p class="mt-5 max-w-xl text-lg leading-8 text-[#98A2B3]">The regular macOS app owns its bundled Go service. Use the menu bar for quick changes and the full System Settings-style window for deeper management.</p>

            <div class="mt-9 space-y-7">
              {appBenefits.map((benefit) => (
                <div class="benefit-row">
                  <span><Icon name={benefit.icon} class="h-5 w-5" /></span>
                  <div>
                    <h3>{benefit.title}</h3>
                    <p>{benefit.body}</p>
                  </div>
                </div>
              ))}
            </div>

            <a class="text-link mt-9" href="/docs/guides/tray">
              See the macOS app guide
              <Icon name="ph:arrow-up-right" class="h-4 w-4" />
            </a>
          </div>
        </div>
      </section>

      <section class="section-shell">
        <div class="mx-auto w-full max-w-7xl px-5 sm:px-8">
          <div class="section-heading max-w-3xl">
            <p class="section-kicker">Built for the real workflow</p>
            <h2>Less credential choreography. More coding.</h2>
          </div>

          <div class="mt-14 grid gap-5 md:grid-cols-3">
            {proof.map((item) => (
              <article class="proof-card">
                <span class="proof-icon"><Icon name={item.icon} class="h-5 w-5" /></span>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
                <a href={item.href}>
                  {item.link}
                  <Icon name="ph:arrow-right" class="h-4 w-4" />
                </a>
              </article>
            ))}
          </div>

          <div class="boundary-note mt-8">
            <Icon name="ph:info" class="h-5 w-5 shrink-0 text-[#A78BFA]" />
            <p><strong>Clear compatibility boundaries:</strong> Claude Code and Codex can use foreign-provider sources. Gemini and Kiro switch only among their own provider accounts. The Codex desktop app keeps its own signed-in account and does not follow a CLI credential switch.</p>
          </div>
        </div>
      </section>

      <section class="px-5 pb-20 sm:px-8 sm:pb-28">
        <div class="closing mx-auto max-w-7xl overflow-hidden px-6 py-14 text-center sm:px-10 sm:py-20">
          <div class="closing-light" aria-hidden="true"></div>
          <p class="section-kicker relative">Ready when your tools are</p>
          <h2 class="relative mx-auto mt-4 max-w-3xl text-balance text-[clamp(2.4rem,6vw,4.5rem)] font-semibold leading-[1] tracking-[-0.05em]">Pick the route once.<br />Keep coding.</h2>
          <div class="relative mt-8 flex flex-wrap justify-center gap-3">
            <a class="primary-cta" href={releasesUrl}>
              Get the release
              <Icon name="ph:arrow-right" class="h-4 w-4" />
            </a>
            <a class="secondary-cta" href="/docs/reference/cli">Read the CLI reference</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="border-t border-white/8 px-5 py-8 sm:px-8">
      <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-5 sm:flex-row">
        <img src="/logo-dark.svg" alt={config.title} width="98" height="20" />
        <p class="text-center text-sm text-[#8b93a7]">Route compatible sources. Keep every change explicit.</p>
        <div class="flex gap-5 text-sm">
          <a href="/docs">Docs</a>
          {config.github && <a href={config.github} target="_blank" rel="noopener">GitHub</a>}
        </div>
      </div>
    </footer>
  </div>

  <script>
    const status = document.querySelector("[data-copy-status]");

    document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
      button.addEventListener("click", async () => {
        const value = button.dataset.copy;
        if (!value) return;
        await navigator.clipboard.writeText(value);
        button.querySelector(".copy-icon")?.classList.add("hidden");
        button.querySelector(".check-icon")?.classList.remove("hidden");
        const label = button.querySelector("span");
        if (label) label.textContent = "Copied";
        if (status) status.textContent = "npm install command copied";
        window.setTimeout(() => {
          button.querySelector(".copy-icon")?.classList.remove("hidden");
          button.querySelector(".check-icon")?.classList.add("hidden");
          if (label) label.textContent = "Copy";
        }, 1800);
      });
    });
  </script>
</BaseLayout>

<style>
  .landing {
    color-scheme: dark;
  }

  .hero {
    background:
      linear-gradient(180deg, rgb(11 15 25 / 0.25), #080a11 92%),
      #0b0f19;
  }

  .hero-grid {
    opacity: 0.22;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.045) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: linear-gradient(to bottom, black, transparent 88%);
  }

  .hero-light {
    top: 3rem;
    right: -10rem;
    width: 56rem;
    height: 56rem;
    border-radius: 999px;
    background: radial-gradient(circle, rgb(124 58 237 / 0.2), transparent 67%);
  }

  .eyebrow,
  .section-kicker {
    color: #a78bfa;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0;
  }

  .eyebrow span {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: #22c55e;
    box-shadow: 0 0 18px rgb(34 197 94 / 0.7);
  }

  h1 span {
    background: linear-gradient(110deg, #f8fafc 5%, #c4b5fd 52%, #7c3aed 110%);
    background-clip: text;
    color: transparent;
  }

  .hero-copy strong {
    color: #f8fafc;
    font-weight: 550;
  }

  .primary-cta,
  .secondary-cta {
    display: inline-flex;
    min-height: 2.8rem;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    border-radius: 0.75rem;
    padding: 0.72rem 1.05rem;
    font-size: 0.9rem;
    font-weight: 650;
    text-decoration: none;
    transition: 160ms ease;
  }

  .primary-cta {
    background: #7c3aed;
    color: white;
    box-shadow: 0 12px 36px rgb(124 58 237 / 0.25);
  }

  .primary-cta:hover {
    background: #8b5cf6;
    transform: translateY(-1px);
  }

  .secondary-cta {
    border: 1px solid rgb(255 255 255 / 0.13);
    background: rgb(255 255 255 / 0.035);
    color: #d6d9e0;
  }

  .secondary-cta:hover {
    border-color: rgb(255 255 255 / 0.22);
    background: rgb(255 255 255 / 0.07);
    color: white;
  }

  .primary-cta:focus-visible,
  .secondary-cta:focus-visible,
  .text-link:focus-visible,
  .proof-card a:focus-visible,
  footer a:focus-visible {
    border-radius: 0.5rem;
    outline: 2px solid #c4b5fd;
    outline-offset: 3px;
  }

  .download-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.4rem;
    padding: 0.45rem 1rem;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 0.85rem;
    background: rgb(4 6 12 / 0.7);
    box-shadow: 0 14px 40px rgb(0 0 0 / 0.22);
    color: #d6d9e0;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }

  .download-link:hover {
    border-color: rgb(255 255 255 / 0.2);
    color: white;
  }

  .download-link:focus-visible {
    outline: 2px solid #c4b5fd;
    outline-offset: 2px;
  }

  .install-shell {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.9rem;
    padding: 0.35rem 0.35rem 0.35rem 1rem;
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 0.85rem;
    background: rgb(4 6 12 / 0.55);
    box-shadow: 0 10px 28px rgb(0 0 0 / 0.16);
  }

  .install-shell .prompt {
    color: #7c3aed;
    font-family: var(--font-mono);
  }

  .install-shell code {
    overflow: hidden;
    color: #d6d9e0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .install-shell button {
    display: inline-flex;
    min-height: 2.2rem;
    align-items: center;
    gap: 0.4rem;
    border: 0;
    border-radius: 0.6rem;
    padding: 0 0.75rem;
    background: rgb(255 255 255 / 0.07);
    color: #98a2b3;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .install-shell button:hover {
    background: rgb(255 255 255 / 0.11);
    color: white;
  }

  .install-shell button:focus-visible {
    outline: 2px solid #c4b5fd;
    outline-offset: 2px;
  }

  .section-shell {
    padding-block: clamp(5.5rem, 10vw, 8.5rem);
    scroll-margin-top: 4rem;
  }

  .section-heading h2 {
    margin-top: 1rem;
    color: #f8fafc;
    font-size: clamp(2.25rem, 5vw, 3.8rem);
    font-weight: 620;
    line-height: 1.04;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .section-heading > p:last-child {
    margin-top: 1.35rem;
    color: #98a2b3;
    font-size: 1.08rem;
    line-height: 1.8;
  }

  .workflow-card,
  .proof-card {
    border: 1px solid rgb(255 255 255 / 0.09);
    border-radius: 1rem;
    background: rgb(255 255 255 / 0.025);
  }

  .workflow-card {
    padding: 1.6rem;
  }

  .workflow-card:hover,
  .proof-card:hover {
    border-color: rgb(167 139 250 / 0.3);
    background: rgb(124 58 237 / 0.045);
  }

  .step-number {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid rgb(167 139 250 / 0.22);
    border-radius: 0.7rem;
    background: rgb(124 58 237 / 0.1);
    color: #a78bfa;
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .workflow-card h3,
  .benefit-row h3,
  .proof-card h3 {
    color: #f8fafc;
    font-size: 1rem;
    font-weight: 620;
  }

  .workflow-card p,
  .benefit-row p,
  .proof-card p {
    margin-top: 0.55rem;
    color: #98a2b3;
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .plan-panel {
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 1.1rem;
    background: #0b0d15;
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.2);
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: #a78bfa;
    font-size: 0.86rem;
    font-weight: 600;
    text-decoration: none;
  }

  .text-link:hover {
    color: #c4b5fd;
  }

  .plan-code {
    background: #07090e;
  }

  .plan-titlebar {
    display: flex;
    align-items: center;
    gap: 0.38rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }

  .plan-titlebar span {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: #343947;
  }

  .plan-titlebar span:first-child {
    background: #7c3aed;
  }

  .plan-titlebar p {
    margin-left: auto;
    color: #8b93a7;
    font-family: var(--font-mono);
    font-size: 0.66rem;
  }

  .plan-code ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .plan-code li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.06);
  }

  .plan-code li:last-child {
    border: 0;
  }

  .plan-code li > span {
    color: #8b93a7;
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .plan-code li div {
    display: grid;
    gap: 0.2rem;
  }

  .plan-code strong {
    color: #e6e8ee;
    font-size: 0.82rem;
    font-weight: 580;
  }

  .plan-code small {
    overflow: hidden;
    color: #8b93a7;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .plan-code b {
    color: #a78bfa;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 500;
  }

  .benefit-row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
  }

  .benefit-row > span,
  .proof-icon {
    display: grid;
    width: 2.6rem;
    height: 2.6rem;
    place-items: center;
    border: 1px solid rgb(167 139 250 / 0.2);
    border-radius: 0.75rem;
    background: rgb(124 58 237 / 0.09);
    color: #a78bfa;
  }

  .proof-card {
    display: flex;
    min-height: 19rem;
    flex-direction: column;
    padding: 1.7rem;
    transition: 160ms ease;
  }

  .proof-card h3 {
    margin-top: 1.5rem;
    font-size: 1.08rem;
