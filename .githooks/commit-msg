#!/bin/sh
#
# Commit-message gate for AnyPick.
#
# Why this exists: the review standard (CODE_REVIEW.md §7) attaches the risk
# classification and the independent-review record to a *pull request*. This
# repository has never used one -- 91 commits, zero merge commits, all direct to
# main -- so nothing in .github/ has ever executed. The commit is therefore the
# only reviewable unit that actually exists here, and this hook is the only gate
# that can fire on it.
#
# It enforces three things CODE_REVIEW.md already requires and nothing enforced:
#   1. Conventional Commits subject (§4) -- subjects ARE the changelog.
#   2. A risk class on every change (§7) -- Low/Normal/High/Architectural.
#   3. An independent reviewer for High and Architectural (§1, §7).
#      Self-review is not independent review; a name is required.
#
# No escape hatch is provided on purpose (§5: never weaken a gate).
# `git commit --no-verify` is a P0 on the committer, not a shortcut.

set -eu

msg_file=${1:?commit-msg hook needs the message file path}

# A blocked commit must not lose the message the author wrote.
# (`$msg_file` is removed by git only when the hook exits non-zero and git was
# asked to abort; we never edit it.)

subject_line=$(grep -v '^#' "$msg_file" | grep -m1 '[^[:space:]]' || true)

# Merge commits are not authored here; they carry git's own subject.
#
# `fixup!`/`squash!` are the same kind of thing: git writes them and
# `git rebase --autosquash` rewrites them away before the branch is shared, so
# there is no landing message to classify. Blocking them would block a normal
# workflow with no escape hatch -- and `--no-verify` is a P0 (§5) -- which is the
# "a rule that cannot be followed decays" failure this file exists to avoid.
#
# `Revert "..."` is deliberately NOT exempt. A revert is a real commit that lands
# and belongs in the changelog, and git's generated subject cannot be parsed into
# a release note. `revert:` is already an accepted type, so a correct path exists;
# the case below says so, rather than failing with a type list that already
# contains `revert` while rejecting the form `git revert` actually produces.
case "$subject_line" in
  "Merge "*) exit 0 ;;
  "fixup! "*|"squash! "*) exit 0 ;;
esac

fail() {
  printf '%s\n' "$1" >&2
  exit 1
}

if [ -z "$subject_line" ]; then
  fail "commit-msg: empty subject"
fi

# git's own revert subject, named explicitly so the failure teaches the fix.
case "$subject_line" in
  'Revert "'*)
    fail "commit-msg: this is git's generated revert subject, and it is not a
  Conventional Commit (CODE_REVIEW.md §4).

  got: $subject_line

  A revert lands on main like any other change, so its subject has to be
  parseable -- only feat, fix and perf appear in a release. Write one:

    git revert --edit <sha>       # then use:  revert: <the reverted subject>

  The type 'revert:' is valid; 'Revert \"...\"' is not. The Risk: trailer is
  still required, so the revert is classified like any other change."
    ;;
esac

# ---- 1. Conventional Commits -------------------------------------------------
# type [(scope)] [!]: description
# Scopes are lowercase; the description must be non-empty.
if ! printf '%s' "$subject_line" |
     grep -Eq '^(feat|fix|perf|refactor|docs|test|chore|build|ci|style|revert)(\([a-z0-9_./-]+\))?!?: [^[:space:]]'; then
  fail "commit-msg: subject is not a Conventional Commit (CODE_REVIEW.md §4).

  got: $subject_line
  want: <type>[(<scope>)][!]: <description>
  types: feat fix perf refactor docs test chore build ci style revert

  Commit subjects are the changelog -- only feat, fix and perf appear in a
  release (make plan-release). An unparseable subject is a silently dropped
  release note."
fi

# ---- 2. Risk class ------------------------------------------------------------
# One class, chosen by the author, from CODE_REVIEW.md §7.
#
# Read the trailers through git's own parser, never by grepping the message text.
# A line is only a trailer when it sits in the message's final paragraph; a
# `Risk: High` written above a closing paragraph is body prose. Grepping the raw
# file accepts it -- and then `git log --format='%(trailers:key=Risk)'`, which is
# how this repository reads a commit's classification, returns nothing. The gate
# would be enforcing a record nobody can retrieve, including a `Reviewed-By:`
# that git cannot see. Verified before this was changed: a message with a
# trailing paragraph exited 0 under the old check and parsed to zero trailers.
#
# `git interpret-trailers` is plumbing over stdin and needs no repository
# (checked outside one), so the mutation suite still runs from any directory.
trailers=$(git interpret-trailers --parse < "$msg_file" || true)

# Trailer KEYS are case-insensitive to git: `RISK: High` is a trailer, and
# `%(trailers:key=Risk)` returns it. Matching the value case-insensitively while
# extracting it case-sensitively is therefore a bypass, not a style nit: the
# existence check accepted `RISK: High`, the extraction did not recognise it, the
# High branch never ran, and the independent-review requirement was dropped.
# Verified before this was fixed -- `RISK: High` with no `Reviewed-By` exited 0,
# and `REVIEWED-BY: <the author>` exited 0. Normalise once, then match once.
trailers_lc=$(printf '%s\n' "$trailers" | tr '[:upper:]' '[:lower:]')

risk=$(printf '%s\n' "$trailers_lc" | grep -E '^risk:[[:space:]]*(low|normal|high|architectural)[[:space:]]*$' || true)

if [ -z "$risk" ]; then
  fail "commit-msg: missing 'Risk:' trailer (CODE_REVIEW.md §7).

  Add exactly one line to the message body:

    Risk: Low             typo, comment, docs-only; no contract change
    Risk: Normal          bounded change in a familiar area; no trust boundary
    Risk: High            credentials, activation, transfer, proxy/secrets,
                          locking, persistence/schema, protocol, release,
                          a gate or exemption, or an unfamiliar area
    Risk: Architectural   constrains future work; needs a new ADR

  When uncertain, choose the higher class."
fi

# grep -c guards against two trailer lines, which is an ambiguous classification.
risk_count=$(printf '%s\n' "$trailers_lc" | grep -cE '^risk:[[:space:]]*(low|normal|high|architectural)[[:space:]]*$' || true)
if [ "$risk_count" != 1 ]; then
  fail "commit-msg: expected exactly one 'Risk:' trailer, found $risk_count"
fi

risk_value=$(printf '%s' "$risk" | sed 's/^risk:[[:space:]]*//')

# ---- 3. Independent review for High and Architectural -------------------------
case "$risk_value" in
  high|architectural)
    if ! printf '%s\n' "$trailers_lc" | grep -qE '^reviewed-by:[[:space:]]*[^[:space:]]'; then
      fail "commit-msg: Risk: $risk_value requires an independent review (CODE_REVIEW.md §1, §7).

  The author never approves their own work, and an agent that wrote a change
  and then reported on it produced one artifact, not two. Add:

    Reviewed-By: <named human, or the separate agent context that reviewed it>

  The named context must not be the one that authored or repaired the change."
    fi

    # A name is not a second context. The one case a machine can actually decide
    # is "the reviewer is the author", so decide it: CODE_REVIEW.md §1 calls
    # independent review the single most important rule in this document, and
    # `Reviewed-By: <my own name>` is the trivial way to satisfy its letter while
    # breaking it. Case-insensitive, and matched against both the name and the
    # address, because either is a plausible thing to write. An empty identity
    # cannot match a non-empty reviewer, so a machine without git config is not
    # blocked by this.
    author_name=$(git var GIT_AUTHOR_IDENT 2>/dev/null | sed 's/ <.*//' || true)
    author_mail=$(git var GIT_AUTHOR_IDENT 2>/dev/null | sed -n 's/.*<\(.*\)>.*/\1/p' || true)
    reviewer=$(printf '%s\n' "$trailers_lc" | sed -n 's/^reviewed-by:[[:space:]]*//p' | head -1)
    author_lc=$(printf '%s' "$author_name" | tr '[:upper:]' '[:lower:]')
    mail_lc=$(printf '%s' "$author_mail" | tr '[:upper:]' '[:lower:]')

    if [ -n "$reviewer" ]; then
      case "$reviewer" in
        "$author_lc"|"$mail_lc")
          fail "commit-msg: Reviewed-By names the author (CODE_REVIEW.md §1).

  Reviewed-By: $reviewer
  author:      $author_name <$author_mail>

  Self-review is not independent review. An agent that wrote a change and then
  reported on it produced one artifact, not two. Name the separate context that
  reviewed it -- a different agent session, or a human."
          ;;
      esac
    fi

    if [ "$risk_value" = "architectural" ] &&
       ! printf '%s\n' "$trailers_lc" | grep -qE '^adr:[[:space:]]*[^[:space:]]'; then
      fail "commit-msg: Risk: architectural requires an ADR (CODE_REVIEW.md §7).

  Add a trailer naming the record, e.g.:

    ADR: adr/0023-<slug>.md

  Accepted ADRs are superseded, never edited."
    fi
    ;;
esac

exit 0
