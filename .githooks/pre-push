#!/bin/sh
#
# Pre-push gate for AnyPick: the mechanical half of make review (CODE_REVIEW.md §4).
#
# CI runs on push, which is too late -- the change is already on the shared
# branch and the cost of a red gate is paid by everyone who pulls. This runs the
# fast, deterministic gates locally, before the push goes out.
#
# Scope, decided 2026-09-11: `make fmt-check vet gates`, not the whole
# `make review`. The test suite is the expensive part -- `make review` measured
# 10m02s on this tree (TEAM_QUALITY_BASELINE_2026-09-08.md) -- and it is already
# CI's job on the same push, so running it here bought a local duplicate of a
# gate that fires minutes later, at the cost of ten minutes per push. A gate
# that costs more than it is worth is a gate people learn to skip, and
# `git push --no-verify` is a P0 on the pusher (§5). The cheap gates below are
# the ones where a local catch is worth real money: formatting, vet, and the
# path/parity/ownership gates.
#
# Nothing was deleted. `make ci` and CI still run the full suite; `make review`
# is unchanged and still the complete local gate for anyone who wants it.
#
# No escape hatch. `git push --no-verify` is a P0 on the pusher (§5).

set -eu

# The ref list git feeds us on stdin must not be consumed; make would inherit an
# empty stdin otherwise.
exec < /dev/null

if ! command -v make > /dev/null 2>&1; then
  printf '%s\n' "pre-push: 'make' is not on PATH -- gate not run, push refused." >&2
  printf '%s\n' "A gate that cannot run is a gate that is silently green (CODE_REVIEW.md §1)." >&2
  exit 1
fi

printf '%s\n' "pre-push: make fmt-check vet gates (the test suite is CI's job)"

if make fmt-check vet gates; then
  printf '%s\n' "pre-push: gates green"
  exit 0
fi

printf '%s\n' "" >&2
printf '%s\n' "pre-push: gates FAILED -- push refused." >&2
printf '%s\n' "Fix the change. Do not weaken the gate, delete a test, or loosen a fixture (§5)." >&2
exit 1
