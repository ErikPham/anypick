#!/bin/sh
#
# Pre-push gate for AnyPick: make review (CODE_REVIEW.md §4).
#
# CI runs on push, which is too late -- the change is already on the shared
# branch and the cost of a red gate is paid by everyone who pulls. This runs
# the universal gate locally, before the push goes out.
#
# make review = fmt-check + vet + test + gates. Measured at ~10 minutes on this
# tree (TEAM_QUALITY_BASELINE_2026-09-08.md); that is the price of the standard,
# not a bug in the hook. If it becomes unbearable, split it (fmt-check/vet/gates
# on pre-commit, tests here) -- do not delete a step.
#
# No escape hatch. `git push --no-verify` is a P0 on the pusher (§5).

set -eu

# The ref list git feeds us on stdin must not be consumed; make would inherit an
# empty stdin otherwise.
exec < /dev/null

if ! command -v make > /dev/null 2>&1; then
  printf '%s\n' "pre-push: 'make' is not on PATH -- gate not run, push refused." >&2
  printf '%s\n' "A gate that cannot run is a gate that is silently green (CODE_REVIEW.md §1)." >&2
  exit 1
fi

printf '%s\n' "pre-push: make review (fmt-check + vet + test + gates)"

if make review; then
  printf '%s\n' "pre-push: make review green"
  exit 0
fi

printf '%s\n' "" >&2
printf '%s\n' "pre-push: make review FAILED -- push refused." >&2
printf '%s\n' "Fix the change. Do not weaken the gate, delete a test, or loosen a fixture (§5)." >&2
exit 1
