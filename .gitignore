/.env
/.env.*
/*.anypick-backup
/node_modules/
*.tgz
*.log
.DS_Store
/coverage/
/.anypick-test/
/*.anypick.json
docs/.astro/
docs/dist/
/.claude/
/.pi/
# Local OpenCode state. Anchored like the other assistant directories so a
# nested folder of the same name stays visible to git.
/.opencode/
# A local planning note, not a spec the build or the docs cite.
/TECHNICAL_IMPROVEMENT_PLAN.md

# Local design mocks / ad-hoc screenshots — not product source.
# Anchored to the root: an unanchored `design/` matches at any depth and will
# silently swallow a nested directory of the same name.
/design/
/brand.png
/*.png
/*.jpg
/*.jpeg
/*.webp
*.db-wal
*.db-shm

# Compiled artifacts never belong in the tree (project is Go-first)
*.exe
*.profraw

# Local scratch: ad-hoc screenshots, browser probes, assistant data.
# Anchored to the repository root on purpose. An unanchored `refs/` matches at
# any depth, and it swallowed src/go/internal/refs — a real Go package that 45
# committed files import — so that package could never be committed and `main`
# did not build, while `git status` stayed completely silent about it.
/refs/
/.playwright-mcp/
/.workbuddy-ai/

# Tauri desktop app (Linux/Windows) build output
/src/tauri/frontend/
/src/tauri/app/target/
/src/tauri/app/binaries/*.exe
/src/tauri/app/binaries/anypick-core-*
/src/tauri/ui/node_modules/
# Generated by `make screenshots-tauri-ui`. Anchored: an unanchored rule here
# also matches any same-named directory deeper in the tree.
/src/tauri/ui/.screenshots/

# Go build output. Every path here is anchored to the repository root.
#
# The old entries were `go/bin/`, `go/anypick` and `go/go/` — written before
# commit 44e5046 grouped all source under src/. After the move they matched
# nothing, and an unanchored pattern is exactly how src/go/internal/refs once
# got swallowed. The built binary is a release artifact: `make build` and the
# release workflow produce it, so it must never be committed.
/src/go/bin/
/src/go/anypick
/src/go/anypick.exe
