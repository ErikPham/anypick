# Local design mocks / ad-hoc screenshots — not product source.
# Anchored to the root: an unanchored `design/` matches at any depth and will
# silently swallow a nested directory of the same name.
/design/
/brand.png
/*.png
/*.jpg
/*.jpeg
/*.webp
go/bin/
go/anypick
/go/anypick.exe
go/go/
npm/*/bin/
*.db-wal
*.db-shm

# Compiled artifacts never belong in the tree (project is Go-first)
*.exe
*.profraw

# Local scratch: ad-hoc screenshots, browser probes, assistant data.
# Anchored to the repository root on purpose. An unanchored `refs/` matches at
# any depth, and it swallowed src/go/internal/refs — a real Go package that 45
# committed files import — so that package could never be committed and `main`
# did not build, while `git status` stayed completely silent about it.
/refs/
.playwright-mcp/
.workbuddy-ai/

# Tauri desktop app (Linux/Windows) build output
src/tauri/frontend/
src/tauri/src-tauri/target/
src/tauri/src-tauri/binaries/*.exe
src/tauri/src-tauri/binaries/anypick-core-*
src/tauri/ui/node_modules/

# Go build output
src/go/bin/
